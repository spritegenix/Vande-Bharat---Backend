model Tag {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  comments Comment[]
  groups   Group[]
  pages    Page[]
  posts    Post[]
  products Product[]

  tagHistory TagHistory[]

  @@map("tags")
}

model TagHistory {
  id    String  @id @default(uuid())
  tagId String
  name  String?

  createdAt DateTime?
  updatedAt DateTime?
  deletedAt DateTime?

  tag Tag @relation(fields: [tagId], references: [id])

  @@map("tag_histories")
}
