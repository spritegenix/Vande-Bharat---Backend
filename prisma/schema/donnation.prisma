model Donation {
  id          String         @id @default(uuid())
  amount      Decimal        @db.Decimal(10, 2)
  description Json?
  status      DonationStatus @default(PENDING)
  razorpayId  String?        @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  donator   Page   @relation("PageMadeDonations", fields: [donatorId], references: [id], onDelete: Cascade)
  donatorId String
  donated   Page   @relation("PageReceivedDonations", fields: [donatedId], references: [id], onDelete: Cascade)
  donatedId String

  donationHistory DonationHistory[]

  @@index([donatorId])
  @@index([donatedId])
  @@map("donations")
}

model DonationHistory {
  id          String   @id @default(uuid())
  donationId  String
  amount      Decimal?
  description Json?
  status      String?
  razorpayId  String?

  createdAt DateTime?
  updatedAt DateTime?
  deletedAt DateTime?

  donatorId String?
  donatedId String?

  donation Donation @relation(fields: [donationId], references: [id])

  @@index([donationId])
  @@map("donation_histories")
}

enum DonationStatus {
  PENDING
  PAID
}
