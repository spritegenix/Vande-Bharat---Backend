model Group {
  id           String       @id @default(uuid())
  slug         String?      @unique
  name         String
  description  Json?
  privacy      GroupPrivacy @default(PUBLIC)
  banner       String?
  isHidden     Boolean      @default(false)
  isBlocked    Boolean      @default(false)
  isVerified   Boolean      @default(false)
  membersCount Int?         @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner      Page          @relation(fields: [ownerId], references: [id])
  ownerId    String
  addresses  Address[]
  members    GroupMember[]
  category   Category?     @relation(fields: [categoryId], references: [id])
  categoryId String?
  posts      Post[]
  reports    Report[]
  tags       Tag[]

  groupHistory GroupHistory[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id     String       @id @default(uuid())
  status MemberStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  group    Group  @relation(fields: [groupId], references: [id])
  groupId  String
  member   Page   @relation(fields: [memberId], references: [id])
  memberId String

  groupMemberHistory GroupMemberHistory[]

  @@unique([memberId, groupId])
  @@index([memberId])
  @@index([groupId])
  @@map("group_members")
}

model GroupHistory {
  id           String   @id @default(uuid())
  groupId      String
  slug         String?
  name         String?
  description  Json?
  privacy      String?
  banner       String?
  isHidden     Boolean?
  isBlocked    Boolean?
  isVerified   Boolean?
  membersCount Int?

  createdAt DateTime?
  updatedAt DateTime?
  deletedAt DateTime?

  ownerId    String?
  categoryId String?

  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("group_histories")
}

model GroupMemberHistory {
  id            String  @id @default(uuid())
  groupMemberId String
  status        String?

  createdAt DateTime?
  updatedAt DateTime?
  deletedAt DateTime?

  groupId  String?
  memberId String?

  groupMember GroupMember @relation(fields: [groupMemberId], references: [id])

  @@index([groupMemberId])
  @@map("group_member_histories")
}

enum GroupPrivacy {
  PRIVATE
  PUBLIC
}

enum MemberStatus {
  PENDING
  ACCEPTED
  REJECTED
}
