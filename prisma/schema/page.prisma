model Page {
    id                 String      @id @default(uuid())
    slug               String?     @unique
    name               String
    description        String?
    banner             String?
    avatar             String?
    pageContactDetails Json?
    isDefault          Boolean     @default(false)
    isHidden           Boolean     @default(false)
    isBlocked          Boolean     @default(false)
    isVerified         Boolean     @default(false)
    followerCount      Int?        @default(0)
    postCount          Int?        @default(0)
    privacy            PagePrivacy @default(PUBLIC)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    owner   User   @relation(fields: [ownerId], references: [id])
    ownerId String

    categories    Category[]
    tags          Tag[]
    addresses     Address[]
    notifications Notification[]

    followers PageFollower[] @relation("PageFollowers")
    following PageFollower[] @relation("PageFollowing")

    ownedGroups  Group[]
    joinedGroups GroupMember[]

    posts     Post[]
    comments  Comment[]
    reactions Reaction[]
    bookmarks Bookmark[]

    orders    Order[] // Orders for this seller
    products  Product[] // List of products sold by this seller
    cartItems CartItem[] // List of CartItems for this page (seller's cart for buyers)

    donated Donation[] @relation("PageReceivedDonations")
    donors  Donation[] @relation("PageMadeDonations")

    reports     Report[]
    pageHistory PageHistory[]

    @@index([ownerId])
    @@index([slug])
    @@map("pages")
}

model PageFollower {
    id              String       @id @default(uuid())
    status          FollowStatus @default(PENDING)
    statusUpdatedAt DateTime? // Added to track last status change

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    follower    Page   @relation("PageFollowers", fields: [followerId], references: [id], onDelete: Cascade)
    followerId  String
    following   Page   @relation("PageFollowing", fields: [followingId], references: [id], onDelete: Cascade)
    followingId String

    pageFollowerHistory PageFollowerHistory[]

    @@unique([followerId, followingId])
    @@index([followerId])
    @@index([followingId])
    @@map("page_followers")
}

model PageHistory {
    id                 String   @id @default(uuid())
    pageId             String
    slug               String?
    name               String?
    description        String?
    banner             String?
    avatar             String?
    pageContactDetails Json?
    isDefault          Boolean?
    isHidden           Boolean?
    isBlocked          Boolean?
    isVerified         Boolean?
    followerCount      Int?
    postCount          Int?
    privacy            String?

    createdAt DateTime? @default(now())
    updatedAt DateTime? @updatedAt
    deletedAt DateTime?

    ownerId String?

    page Page @relation(fields: [pageId], references: [id])

    @@index([pageId])
    @@map("page_histories")
}

model PageFollowerHistory {
    id              String        @id @default(uuid())
    pageFollowerId  String
    status          FollowStatus?
    statusUpdatedAt DateTime? // Track the last time the status changed

    createdAt DateTime? @default(now())
    updatedAt DateTime? @updatedAt
    deletedAt DateTime?

    followerId  String?
    followingId String?

    pageFollower PageFollower @relation(fields: [pageFollowerId], references: [id])

    @@index([pageFollowerId])
    @@map("page_follower_histories")
}

enum PagePrivacy {
    PRIVATE
    PUBLIC
}

enum FollowStatus {
    PENDING
    ACCEPTED
    REJECTED
}
